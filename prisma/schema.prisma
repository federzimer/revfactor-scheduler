generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String?        @unique
  emailVerified    DateTime?
  image            String?
  maxAdvanceDays   Int            @default(30) // how far in advance bookings can be made
  timezone         String         @default("America/New_York") // user's timezone (IANA)
  minBufferHours   Int            @default(2) // minimum hours before a slot can be booked
  role             String         @default("user") // "super_admin" | "user"
  active           Boolean        @default(true) // soft enable/disable a teammate (also gates admin sign-in)
  bookable         Boolean        @default(true) // show in the lead-facing scheduler / accept calls (independent of active)
  bio              String?        // short blurb shown to visitors on the booking page
  hometown         String?        // "where are they from" — shown on booking page
  basedIn          String?        // "where do they live now" — shown on booking page
  strExperience    String?        // short-term-rental experience blurb (e.g. "5 yrs, 40 listings")
  accounts         Account[]
  sessions         Session[]
  availability     Availability[]
  dateOverrides    DateOverride[]
  bookings         Booking[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Availability {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int    // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String // "09:00" format (24h)
  endTime   String // "17:00" format (24h)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DateOverride {
  id        String  @id @default(cuid())
  userId    String
  date      String  // "2025-03-15" format
  isBlocked Boolean @default(true) // true = completely unavailable
  startTime String? // custom hours (if not blocked)
  endTime   String? // custom hours (if not blocked)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Booking {
  id              String   @id @default(cuid())
  userId          String
  date            String   // "2025-03-15" format
  startTime       String   // "10:00" format
  endTime         String   // "10:15" format
  visitorName     String
  visitorEmail    String
  visitorPhone    String?
  visitorCompany  String?
  visitorAirbnbLink String?
  visitorAddress  String?  // physical address when visitor has no listing yet
  visitorHeardAbout String? // "How did you hear about us?" answer
  visitorReferralName String? // name of referrer when heardAbout = Referral
  visitorNotes    String?
  meetLink        String?
  calendarEventId String?
  status          String   @default("confirmed") // confirmed, cancelled
  outcome         String   @default("scheduled") // scheduled, completed, no_show, won, lost
  convertedAt     DateTime? // set when outcome becomes "won"
  outcomeNote     String?  // optional rep note about the outcome
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  followUps       BookingFollowUp[]
}

model BookingFollowUp {
  id                String    @id @default(cuid())
  bookingId         String
  templateKey       String
  subject           String
  body              String
  status            String    @default("sending") // sending, sent, failed
  providerMessageId String?
  error             String?
  sentByUserId      String?
  sentByName        String?
  sentByEmail       String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// Sales FAQ / playbook entries shown to reps in the admin area. Super admins manage them.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?  // optional grouping, e.g. "Pricing", "Objections", "Onboarding"
  sortOrder Int      @default(0) // manual ordering within a category
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shareable files/links (contract, service agreement, decks) shown in the FAQ Resources panel.
// Link-based: each row points at an external URL (Google Drive, Dropbox, etc.). Super admins manage them.
model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?  // optional one-line note about the file
  url         String   // external link to the document
  sortOrder   Int      @default(0) // manual ordering in the panel
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
